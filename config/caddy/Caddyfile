# hyperbase's front door — the post-cutover Caddyfile.
#
# ***NOT APPLIED.*** This is the file that replaces
# `halcyon/config/caddy/Caddyfile` at the cutover step that says so in
# `docs/cutover.md`. Copying it into place is the first change a visitor can see
# and it is the step the runbook calls irreversible-in-practice. Do not `caddy
# reload` this from a deploy script.
#
# It runs in halcyon's existing caddy container, on halcyon's existing `web`
# network, with halcyon's existing certificates — deliberately. Standing up a
# second reverse proxy would mean a second ACME account, a second set of certs,
# and a cutover whose first step is a DNS change with a TTL on it. Replacing one
# file in a container that is already serving is a cutover whose rollback is
# replacing it back.
#
# ---------------------------------------------------------------------------
# What changed from halcyon's
# ---------------------------------------------------------------------------
#
# halcyon routed four hostnames to four containers. hyperbase is **one SPA and
# one bundle** — design §14 — so `hb.rjp.io`, `notes.rjp.io` and
# `feedbot.rjp.io` are three hostnames in front of one `web` container. The
# gateway carries a per-app host's path into that app's namespace, which is what
# mounts notes at the root of `notes.rjp.io`; `hb.rjp.io` serves every route the
# bundle carries.
#
# Three things stay exactly as they were:
#
#   * **blog** (`rjp.io`, `www.rjp.io`, `taco.rjp.io`) is untouched. It is not
#     ported and this file is not the place to port it.
#   * **kana-quiz** (`kana.rjp.io`) stays in halcyon as a foreign app: route plus
#     session, nothing more (design §14). Its block below is byte-identical to
#     halcyon's except for the comment.
#   * **loom / weaver** and the **spillbench** redirect are deployed out of band
#     and are copied across unchanged, because a Caddyfile that drops a host is a
#     Caddyfile that turns it off.

# ---------------------------------------------------------------------------
# hyperbase
# ---------------------------------------------------------------------------

# Every hyperbase hostname is this and nothing else, so it is written once. A
# second copy of the upstream is a copy that drifts, and the way it drifts is
# one hostname keeping SSE alive through a redeploy while another does not.
(hyperbase) {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# The gateway streams SSE (the agent overlay, job progress) and serves
	# exports that are tens of megabytes. -1 disables response buffering so
	# neither stalls behind `encode` — the same flag loom needs, for the same
	# reason, and the failure without it is a stream that arrives all at once
	# when it finishes rather than one that never arrives at all, which is why
	# it is easy to miss.
	reverse_proxy web:8000 {
		flush_interval -1

		# `hb web` is one process; a redeploy replaces it, and for the second
		# or two before the new one is listening Caddy should wait rather than
		# hand back a 502.
		lb_try_duration 5s
		health_uri /healthz
		health_interval 10s
		health_timeout 2s
	}
}

hb.rjp.io {
	import hyperbase
}

# ---------------------------------------------------------------------------
# The per-site hostnames
# ---------------------------------------------------------------------------
#
# The same gateway. A site is a product with a hostname (design §3), and which
# hostname belongs to which site is a row in `core.sites`, read by the door:
#
#   crates/hb-web/src/hosts.rs
#
# So **adding a site needs one entry here and no rules**: register the site with
# its hostname and the door serves its bundle at the root of that hostname.
# There is no path rewriting to keep in step, because there is no path prefix.
#
# A session belongs to the host it was created on: `__Host-hb_session` is
# host-only by the prefix's own rule, so signing in on `console.rjp.io` and on
# `hb.rjp.io` are two sessions and two `core.sessions` rows. That is what keeps
# the hyperbase session off `rjp.io` and `kana.rjp.io`.

# `notes.rjp.io` is here for the same reason and by the same rule, even though
# `notes` is a hosted site whose pages come out of a second process. Caddy does
# not know that and must not: the door reads `upstream` off the site's row and
# proxies to it, so a hosted site and a kernel site are one entry here.
console.rjp.io, docs.rjp.io, notes.rjp.io, storybook.rjp.io {
	import hyperbase
}

# ---------------------------------------------------------------------------
# Still halcyon's
# ---------------------------------------------------------------------------

rjp.io, www.rjp.io, taco.rjp.io {
	encode zstd gzip
	reverse_proxy blog:8000
}

# kana-quiz is a *foreign app*: it stays in halcyon, it knows nothing about
# hyperbase, and the interim support for it is deliberately thin — route plus
# session, nothing more (design §14). "Plus session" is not implemented by
# anything in this file and cannot be: sharing a session across two origins needs
# either a cookie on `.rjp.io` that hyperbase does not set, or a token exchange
# that does not exist. Today this is route and nothing more, and kana-quiz has no
# login of its own, so nothing is broken by that — but it is the gap to close
# before a second foreign app has one.
kana.rjp.io {
	encode zstd gzip
	reverse_proxy kana-quiz:8000
}

# loom is one server (the `weaver` container) reached under either host.
weaver.rjp.io, loom.rjp.io {
	encode zstd gzip
	# loom streams SSE (/events) and a WebSocket terminal; -1 disables response
	# buffering so neither stalls behind `encode`.
	reverse_proxy weaver:7878 {
		flush_interval -1
	}
}

# spillbench turned down 2026-07-20 — its report now lives in the blog. Keep the
# host as a redirect so links already out there (RSS, shares) still resolve.
spillbench.rjp.io {
	redir https://rjp.io/blog/2026-07-19-register-deprivation permanent
}
