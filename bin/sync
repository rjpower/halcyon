#!/usr/bin/env python3
"""
Bring halcyon's apps up from the checkouts sitting next to this script.

Every app is developed in place: `halcyon/<name>/` is an ordinary git checkout
and the working tree you can see is exactly what ships. So sync never pulls
unless you ask, and it always *builds* — `docker compose up -d` on its own will
cheerfully start a stale image and say nothing about it.

Afterwards sync reconciles the Caddy front door and then asks Caddy, over its
admin API, which hosts it is *actually* serving. A Caddyfile that was edited but
never loaded is the exact failure this check exists to catch.

    bin/sync                # build + up every app, then the front door
    bin/sync feedbot        # just one
    bin/sync --check        # read-only: report drift, change nothing
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

HALCYON = Path(__file__).resolve().parent.parent
CONFIG = HALCYON / "config"
SECRETS = HALCYON / "secrets"
MANIFEST = CONFIG / "apps.toml"
CADDY_COMPOSE = CONFIG / "docker-compose.yml"
CADDYFILE = CONFIG / "caddy" / "Caddyfile"

# Caddy's admin API listens on 127.0.0.1 inside its own container. Asking it
# what it serves is not the same as reading the Caddyfile and assuming.
CADDY_ADMIN = "http://127.0.0.1:2019/config/"

failed = False


def say(level: str, label: str, detail: str = "") -> None:
    global failed
    if level == "bad":
        failed = True
    mark = {"ok": "ok  ", "warn": "warn", "bad": "FAIL", "note": "    "}[level]
    print(f"  {mark} {label:<13} {detail}".rstrip())


def run(cmd: list[str], *, check: bool = True) -> subprocess.CompletedProcess:
    print(f"  $ {' '.join(cmd)}", file=sys.stderr)
    return subprocess.run(cmd, check=check, text=True)


def out(cmd: list[str]) -> subprocess.CompletedProcess:
    """Run quietly and hand back the result; never raises."""
    return subprocess.run(cmd, check=False, text=True, capture_output=True)


# ---- the checkout ---------------------------------------------------------


def app_dir(name: str, app: dict) -> Path:
    return HALCYON / app.get("dir", name)


def hosts_of(app: dict) -> list[str]:
    return list(app.get("hosts", []))


def git_state(d: Path) -> dict | None:
    if out(["git", "-C", str(d), "rev-parse", "--is-inside-work-tree"]).returncode != 0:
        return None

    def g(*a: str) -> str:
        return out(["git", "-C", str(d), *a]).stdout.strip()

    behind = ahead = 0
    p = out(["git", "-C", str(d), "rev-list", "--left-right", "--count", "@{u}...HEAD"])
    if p.returncode == 0 and len(p.stdout.split()) == 2:
        behind, ahead = (int(x) for x in p.stdout.split())
    return {
        "branch": g("rev-parse", "--abbrev-ref", "HEAD"),
        "head": g("rev-parse", "--short", "HEAD"),
        "dirty": len([ln for ln in g("status", "--porcelain").splitlines() if ln.strip()]),
        "behind": behind,
        "ahead": ahead,
    }


def ensure_checkout(name: str, app: dict, d: Path, *, pull: bool) -> None:
    if not d.exists():
        repo = app.get("repo")
        if not repo:
            sys.exit(f"[{name}] {d} is missing and apps.toml gives no `repo` to clone")
        run(["git", "clone", "--branch", app.get("branch", "main"), repo, str(d)])
    elif pull:
        st = git_state(d)
        if st and st["dirty"]:
            sys.exit(f"[{name}] {st['dirty']} uncommitted file(s) — commit or stash before --pull")
        run(["git", "-C", str(d), "pull", "--ff-only"])
    if not (d / "docker-compose.yml").exists():
        sys.exit(f"[{name}] no docker-compose.yml in {d}")


def ensure_secret(name: str) -> Path:
    SECRETS.mkdir(mode=0o700, exist_ok=True)
    os.chmod(SECRETS, 0o700)
    secret = SECRETS / f"{name}.env"
    if not secret.exists():
        secret.write_text(f"# {name} secrets — KEY=VALUE per line, no quotes\n")
        print(f"  ! created empty {secret}; populate it", file=sys.stderr)
    os.chmod(secret, 0o600)
    return secret


def link_env(d: Path, secret: Path) -> None:
    """Symlink <app>/.env at the canonical secret file, by relative path."""
    link = d / ".env"
    target = Path(os.path.relpath(secret, d))
    if link.is_symlink():
        if Path(os.readlink(link)) == target:
            return
        link.unlink()
    elif link.exists():
        sys.exit(f"{link} exists and is not a symlink — move its contents into {secret}, delete it, re-run")
    link.symlink_to(target)


# ---- docker ---------------------------------------------------------------


def container(name: str) -> dict | None:
    fmt = (
        "{{.State.Status}}\t"
        "{{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}\t"
        "{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}"
    )
    p = out(["docker", "inspect", name, "--format", fmt])
    if p.returncode != 0:
        return None
    status, health, nets = (p.stdout.strip("\n").split("\t") + ["", "", ""])[:3]
    return {"status": status, "health": health, "nets": nets.split()}


def ensure_web_network() -> None:
    if out(["docker", "network", "inspect", "web"]).returncode != 0:
        run(["docker", "network", "create", "web"])


def compose_up(d: Path, *, build: bool, recreate: bool) -> None:
    cmd = ["docker", "compose", "-f", str(d / "docker-compose.yml"), "up", "-d"]
    if build:
        cmd.append("--build")
    if recreate:
        cmd.append("--force-recreate")
    run(cmd)


# ---- the front door -------------------------------------------------------


def caddy_hosts(tries: int = 1) -> set[str] | None:
    """Every hostname in the config Caddy is running. None if it can't be asked."""
    for i in range(tries):
        p = out(["docker", "exec", "caddy", "wget", "-qO-", CADDY_ADMIN])
        if p.returncode == 0 and p.stdout.strip():
            found: set[str] = set()

            def walk(node) -> None:
                if isinstance(node, dict):
                    if isinstance(node.get("host"), list):
                        found.update(h for h in node["host"] if isinstance(h, str))
                    for v in node.values():
                        walk(v)
                elif isinstance(node, list):
                    for v in node:
                        walk(v)

            try:
                walk(json.loads(p.stdout))
            except json.JSONDecodeError:
                return None
            return found
        if i + 1 < tries:
            time.sleep(0.5)
    return None


def sync_caddy(expected: set[str], *, note_unmanaged: bool) -> None:
    run(["docker", "compose", "-f", str(CADDY_COMPOSE), "up", "-d"])
    # Racy right after a create — caddy may not be listening on :2019 yet — so
    # this is allowed to fail. The verification below is what actually decides.
    run(["docker", "exec", "caddy", "caddy", "reload", "--config", "/etc/caddy/Caddyfile"], check=False)

    live = caddy_hosts(tries=10) or set()
    if missing := expected - live:
        # Reload is a no-op if the container is holding a stale copy of the
        # config. Recreating is the one thing that always re-reads it.
        print(f"  ! caddy is not serving {sorted(missing)} — recreating it", file=sys.stderr)
        run(["docker", "compose", "-f", str(CADDY_COMPOSE), "up", "-d", "--force-recreate", "caddy"])
        live = caddy_hosts(tries=10) or set()
        missing = expected - live
    if missing:
        sys.exit(f"caddy still is not serving {sorted(missing)} — check {CADDYFILE}")

    print(f"  caddy is serving {len(live)} host(s)", file=sys.stderr)
    if note_unmanaged and (extra := live - expected):
        print(f"  note: also serving {sorted(extra)}, which apps.toml does not declare", file=sys.stderr)


# ---- read-only report -----------------------------------------------------


def check(apps: dict, all_apps: dict, *, scoped: bool) -> int:
    live = caddy_hosts(tries=2)

    for name, app in apps.items():
        print(f"\n=== {name}")
        d = app_dir(name, app)
        if not d.is_dir():
            say("bad", "checkout", f"{d} is missing")
            continue

        st = git_state(d)
        if st is None:
            say("warn", "checkout", f"{d} is not a git repo")
        else:
            say("ok", "checkout", f"{st['branch']} @ {st['head']}")
            if st["dirty"]:
                say("warn", "working tree", f"{st['dirty']} uncommitted file(s) — a deploy ships them")
            if st["behind"]:
                say("note", "behind", f"{st['behind']} commit(s) behind upstream")
            if st["ahead"]:
                say("note", "ahead", f"{st['ahead']} commit(s) not pushed")

        say("ok" if (d / "docker-compose.yml").exists() else "bad", "compose", "docker-compose.yml")

        env = d / ".env"
        if env.is_symlink():
            say("ok", ".env", f"-> {os.readlink(env)}")
        elif env.exists():
            say("bad", ".env", "a regular file, not a symlink into secrets/")
        else:
            say("bad", ".env", "missing — run bin/sync")

        c = container(app.get("container", name))
        if c is None:
            say("bad", "container", "does not exist")
        else:
            ill = c["status"] != "running" or c["health"] not in ("healthy", "-")
            detail = c["status"] + (f", {c['health']}" if c["health"] != "-" else "")
            say("bad" if ill else "ok", "container", detail)
            say("ok" if "web" in c["nets"] else "bad", "network", ", ".join(c["nets"]) or "none")

        hs = hosts_of(app)
        if not hs:
            say("note", "route", "no `hosts` declared in apps.toml")
        elif live is None:
            say("warn", "route", "caddy's admin api is unreachable")
        else:
            for h in hs:
                say("ok" if h in live else "bad", "route", h if h in live else f"{h} — caddy is not serving it")

    print("\n=== front door")
    if live is None:
        say("bad", "caddy", "admin api unreachable — is the container up?")
    else:
        say("ok", "caddy", f"serving {len(live)} host(s)")
        if not scoped:
            declared = {h for a in all_apps.values() for h in hosts_of(a)}
            if extra := live - declared:
                say("note", "unmanaged", f"{', '.join(sorted(extra))} — served by caddy, absent from apps.toml")

    return 1 if failed else 0


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("name", nargs="?", help="only this app (default: all of them)")
    p.add_argument("--check", action="store_true", help="read-only: report drift, change nothing")
    p.add_argument("--no-build", action="store_true", help="start the existing image, don't rebuild")
    p.add_argument("--pull", action="store_true", help="git pull --ff-only first (refused on a dirty tree)")
    p.add_argument("--recreate", action="store_true", help="force-recreate app containers")
    p.add_argument("--skip-caddy", action="store_true", help="leave the front door alone")
    p.add_argument("--force", action="store_true", help="build every app even if its tree is dirty")
    args = p.parse_args()

    if not shutil.which("docker"):
        sys.exit("docker not found on PATH")

    with MANIFEST.open("rb") as fh:
        all_apps: dict[str, dict] = tomllib.load(fh).get("apps", {})
    apps = all_apps
    if args.name:
        if args.name not in all_apps:
            sys.exit(f"unknown app: {args.name} (have: {', '.join(all_apps)})")
        apps = {args.name: all_apps[args.name]}

    if args.check:
        return check(apps, all_apps, scoped=bool(args.name))

    # Every app's compose declares `web` as external, so it has to exist before
    # the first one comes up — not after the last one, as this script once did.
    ensure_web_network()

    # Everything cheap first, so a refusal below costs nothing and no app is
    # left half-deployed behind one that failed to build.
    dirty: list[tuple[str, int]] = []
    for name, app in apps.items():
        print(f"=== {name}", file=sys.stderr)
        d = app_dir(name, app)
        ensure_checkout(name, app, d, pull=args.pull)
        link_env(d, ensure_secret(name))
        if (st := git_state(d)) and st["dirty"]:
            dirty.append((name, st["dirty"]))

    # Naming an app is a statement of intent, and deploying its working tree is
    # the whole point. A bare `bin/sync` is a routine reconcile of everything,
    # and it should never be the thing that ships work you never committed.
    #
    # --no-build is no escape hatch here: `compose up -d` applies the working
    # tree's docker-compose.yml too, so an uncommitted mount or environment
    # change lands on the running container even when the image doesn't move.
    if dirty and not (args.name or args.force):
        listing = "\n".join(f"    {n:<12} {c} uncommitted file(s)" for n, c in dirty)
        sys.exit(
            f"refusing to deploy from a dirty working tree:\n{listing}\n"
            f"Commit or stash, or name the app to say you mean it (bin/sync {dirty[0][0]}), "
            "or pass --force."
        )
    for name, count in dirty:
        print(f"  ! {name}: {count} uncommitted file(s) — deploying from the working tree", file=sys.stderr)

    for name, app in apps.items():
        compose_up(app_dir(name, app), build=not args.no_build, recreate=args.recreate)

    if not args.skip_caddy:
        print("=== front door", file=sys.stderr)
        sync_caddy({h for a in apps.values() for h in hosts_of(a)}, note_unmanaged=not args.name)

    return 0


if __name__ == "__main__":
    sys.exit(main())
