#!/usr/bin/env python3
"""
Interactive: register a new app. Appends an entry to apps.toml, creates an
empty secrets file, and appends a default reverse-proxy block to Caddyfile.
Does not clone or compose-up; run `bin/sync <name>` afterwards.
"""
from __future__ import annotations

import os
import re
import sys
from pathlib import Path

APPS_DIR = Path(__file__).resolve().parent.parent
CONFIG_DIR = APPS_DIR / "config"
MANIFEST = CONFIG_DIR / "apps.toml"
CADDYFILE = CONFIG_DIR / "Caddyfile"
SECRETS_DIR = APPS_DIR / "secrets"

NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")


def prompt(question: str, default: str | None = None) -> str:
    suffix = f" [{default}]" if default else ""
    while True:
        ans = input(f"{question}{suffix}: ").strip()
        if ans:
            return ans
        if default is not None:
            return default


def existing_names() -> set[str]:
    import tomllib
    if not MANIFEST.exists():
        return set()
    with MANIFEST.open("rb") as fh:
        return set(tomllib.load(fh).get("apps", {}).keys())


def main() -> int:
    taken = existing_names()
    while True:
        name = prompt("App name (lower-kebab)")
        if not NAME_RE.match(name):
            print("  must match [a-z0-9][a-z0-9-]*", file=sys.stderr)
            continue
        if name in taken:
            print(f"  '{name}' already in apps.toml", file=sys.stderr)
            continue
        break
    repo = prompt("Git repo URL (ssh or https)")
    path = prompt("Subdir within the clone (compose.yml lives here)", ".")
    branch = prompt("Branch", "main")
    container = prompt("Container name (must match `container_name:` in the app's compose)", name)
    port = prompt("Container port", "8000")
    hostname = prompt("Caddy hostname", f"{name}.rjp.io")

    block = (
        f"\n[apps.{name}]\n"
        f'repo      = "{repo}"\n'
        f'path      = "{path}"\n'
        f'branch    = "{branch}"\n'
        f'container = "{container}"\n'
        f"port      = {port}\n"
        f"cmd       = []\n"
    )
    with MANIFEST.open("a") as fh:
        fh.write(block)

    SECRETS_DIR.mkdir(mode=0o700, exist_ok=True)
    os.chmod(SECRETS_DIR, 0o700)
    secret = SECRETS_DIR / f"{name}.env"
    if not secret.exists():
        secret.write_text(f"# {name} secrets — KEY=VALUE per line, no quotes\n")
        os.chmod(secret, 0o600)

    caddy_block = (
        f"\n{hostname} {{\n"
        f"    encode zstd gzip\n"
        f"    reverse_proxy {container}:{port}\n"
        f"}}\n"
    )
    with CADDYFILE.open("a") as fh:
        fh.write(caddy_block)

    print()
    print(f"Registered '{name}'.")
    print(f"  • Edit secrets: {secret}")
    print(f"  • Point DNS:    {hostname} -> this server")
    print(f"  • Bring up:     bin/sync {name}")
    print(f"  • Caddy:        review the appended block in {CADDYFILE}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
